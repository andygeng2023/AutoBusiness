# Optional overrides for the public Supabase browser client.
# The configured project has a public publishable-key fallback in src/supabase.ts.
# Never put a Supabase service-role key or provider secret in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_public_key
