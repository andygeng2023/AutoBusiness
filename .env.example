# Copy to .env.local and fill in the public project values.
# Never put a Supabase service-role key in frontend environment variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Puter.js is loaded client-side and uses Puter's user-pays authentication flow.
# No Puter secret/API key belongs in this file.